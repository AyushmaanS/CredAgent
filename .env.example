# Copy to .env.local (git-ignored), then fill in values locally.
# Never paste real values into chat, issues, commits, or this file.
# Defaults shown in comments are applied in code when a value is left empty.

# FastRouter (LLM, Jev, and Stagehand's model calls)
FASTROUTER_API_KEY=
# default: https://api.fastrouter.ai/api/v1
FASTROUTER_BASE_URL=
# default: anthropic/claude-sonnet-5.5
CREDAGENT_LLM_MODEL=
# default: anthropic/claude-haiku-5.5
CREDAGENT_STAGEHAND_MODEL=
# default: typesafe/jev-latest
CREDAGENT_JEV_MODEL=

# Redirect/callback URI registered on created OAuth apps.
# default: http://127.0.0.1:8976/callback  (provisional local placeholder; see DECISIONS Q3)
CREDAGENT_REDIRECT_URI=

# Tavily (research)
TAVILY_API_KEY=

# Runtime data directory (run state, browser profiles, secret store).
# default: ~/.credagent  — must be outside the repository
CREDAGENT_HOME=
